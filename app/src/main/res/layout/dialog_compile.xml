<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="22dp"
    android:paddingTop="12dp">

    <EditText
        android:id="@+id/editCompileTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Title (optional)"
        android:singleLine="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Empty title becomes “Compiled” + date and time"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/spinSeparator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp" />

    <CheckBox
        android:id="@+id/chkTitles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Include each note's title" />

    <CheckBox
        android:id="@+id/chkDelete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="Delete the original notes" />
</LinearLayout>
